            {
              "name": "Atacar hasta que haya ganador (usar en el Runner)",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "url": "{{baseUrl}}/games/{{gameId}}/actions",
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"action\": \"attack\"\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                },
                "auth": {
                  "type": "bearer",
                  "bearer": [
                    {
                      "key": "token",
                      "value": "{{actionToken}}",
                      "type": "string"
                    }
                  ]
                },
                "description": "En el Collection Runner se repite solo hasta que el servidor determina al ganador."
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test(\"Código 200\", () => pm.response.to.have.status(200));",
                      "const d = pm.response.json();",
                      "console.log(d.action.description);",
                      "// En el Runner repite este request hasta que el servidor declare ganador",
                      "if (pm.response.code === 200 && d.winnerId === null) { postman.setNextRequest(pm.info.requestName); }",
                      "else { pm.collectionVariables.set('winnerId', d.winnerId); }"
                    ]
                  }
                }
              ]
            }
          ],
          "description": "Antes de cada request consulta de quién es el turno y usa su token automáticamente.",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const base = pm.collectionVariables.get('baseUrl');",
                  "const t1 = pm.collectionVariables.get('token');",
                  "const t2 = pm.collectionVariables.get('token2');",
                  "const p1 = Number(pm.collectionVariables.get('playerId'));",
                  "pm.sendRequest({",
                  "  url: base + '/games/' + pm.collectionVariables.get('gameId'),",
                  "  method: 'GET',",
                  "  header: { Authorization: 'Bearer ' + t1 }",
                  "}, (err, res) => {",
                  "  if (err) { console.log(err); return; }",
                  "  const turnIsP1 = res.json().currentTurnUserId === p1;",
                  "  pm.collectionVariables.set('actionToken', turnIsP1 ? t1 : t2);",
                  "  pm.collectionVariables.set('otherToken', turnIsP1 ? t2 : t1);",
                  "});"
                ]
              }
            }
          ]
        },
