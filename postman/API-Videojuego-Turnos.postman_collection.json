        {
          "name": "Combate (el token del turno se elige solo)",
          "item": [
            {
              "name": "Atacar",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "url": "{{baseUrl}}/games/{{gameId}}/actions",
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"action\": \"attack\"\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                },
                "auth": {
                  "type": "bearer",
                  "bearer": [
                    {
                      "key": "token",
                      "value": "{{actionToken}}",
                      "type": "string"
                    }
                  ]
                },
                "description": "Daño = max(1, ataque*2 - defensa del rival)."
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test(\"Código 200\", () => pm.response.to.have.status(200));",
                      "if (pm.response.code === 200) {",
                      "  const d = pm.response.json();",
                      "  console.log(d.action.description, '| vida actor:', d.action.actorHpAfter, '| vida rival:', d.action.rivalHpAfter);",
                      "}"
                    ]
                  }
                }
              ]
            },
