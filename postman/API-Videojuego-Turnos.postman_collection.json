      "item": [
        {
          "name": "Registrar jugador 1",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"jugador1_{{$timestamp}}\",\n  \"email\": \"jugador1_{{$timestamp}}@correo.com\",\n  \"password\": \"123456\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            },
            "description": "Guarda automáticamente el token, el id y el correo del jugador 1."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Código 201\", () => pm.response.to.have.status(201));",
                  "const d = pm.response.json();",
                  "pm.collectionVariables.set(\"token\", d.token);",
                  "pm.collectionVariables.set(\"playerId\", d.user.id);",
                  "pm.collectionVariables.set(\"email1\", d.user.email);"
                ]
              }
            }
          ]
        },
