{
  "info": {
    "name": "API Videojuego por Turnos",
    "description": "Ejecuta las carpetas en orden (1 a 5) o usa Collection Runner. Requiere la API corriendo en http://localhost:3000 (npm run dev).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "0. Health check",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/health",
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Código 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
